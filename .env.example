# ===================================================
# TELEGRAM BOT CONFIGURATION (បានពី @BotFather)
# ===================================================
# Bot token ទទួលបានពី Telegram @BotFather (ឧ. 7123456789:AAHxyz...)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Telegram Group ឬ Channel ID ដែលចង់ឱ្យ Bot ផ្ញើ Report ចូល (ឧ. -1001234567890 ឬ User ID)
TELEGRAM_CHAT_ID="-1001234567890"

# URL នៃ Web App របស់អ្នក (ឧ. https://cambo-bim-report.vercel.app ឬ http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===================================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ===================================================
# បង្កើត project ឥតគិតថ្លៃនៅ https://supabase.com រួចចម្លង Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
